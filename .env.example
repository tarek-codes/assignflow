# AssignFlow Environment Variables Example

# Frontend (.env.local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5196

# Backend (appsettings.json or Environment Variables)
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=assignflow;Username=postgres;Password=YOUR_POSTGRES_PASSWORD"
Jwt__Issuer="AssignmentManagement"
Jwt__Audience="AssignmentManagement.Web"
Jwt__Secret="YOUR_SUPER_SECRET_KEY_MINIMUM_32_CHARS"
Jwt__ExpiryMinutes=120
Jwt__RefreshTokenExpiryDays=7

# Storage Configuration
Storage__SubmissionRootPath="./storage/submissions"
Storage__MaxUploadSizeMb=10

# Optional Redis Cache Configuration
ConnectionStrings__Redis="redis://localhost:6379"
